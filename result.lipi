সংখ্যা মোট_শিক্ষার্থী = 5;
সংখ্যা নম্বর1 = 85;
সংখ্যা নম্বর2 = 72;
সংখ্যা নম্বর3 = 91;
সংখ্যা নম্বর4 = 64;
সংখ্যা নম্বর5 = 78;

সংখ্যা মোট = নম্বর1 + নম্বর2 + নম্বর3 + নম্বর4 + নম্বর5;
সংখ্যা গড় = মোট / মোট_শিক্ষার্থী;

দেখাও(মোট);
দেখাও(গড়);

যদি (গড় >= 80) {
    দেখাও(1);
} নাহলে {
    যদি (গড় >= 60) {
        দেখাও(2);
    } নাহলে {
        দেখাও(0);
    }
}

সংখ্যা কাউন্টার = 1;
সংখ্যা যোগফল = 0;

যতক্ষণ (কাউন্টার <= মোট_শিক্ষার্থী) {
    যোগফল = যোগফল + কাউন্টার;
    কাউন্টার = কাউন্টার + 1;
}

দেখাও(যোগফল);