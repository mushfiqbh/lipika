সংখ্যা ব্যালেন্স = 10000;
সংখ্যা জমা = 2500;
সংখ্যা খরচ = 3000;

ব্যালেন্স = ব্যালেন্স + জমা;
ব্যালেন্স = ব্যালেন্স - খরচ;

দেখাও(ব্যালেন্স);

যদি (ব্যালেন্স >= 10000) {
    দেখাও(1);
} নাহলে {
    দেখাও(0);
}

সংখ্যা মাস = 1;
সংখ্যা সঞ্চয় = 0;

যতক্ষণ (মাস <= 12) {
    সঞ্চয় = সঞ্চয় + 500;
    মাস = মাস + 1;
}

ব্যালেন্স = ব্যালেন্স + সঞ্চয়;

দেখাও(সঞ্চয়);
দেখাও(ব্যালেন্স);

যদি (ব্যালেন্স >= 15000) {
    দেখাও(1);
} নাহলে {
    দেখাও(0);
}